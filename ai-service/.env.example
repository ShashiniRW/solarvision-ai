# Copy this file to .env and set a long random value.
# The backend must use the SAME value.
INTERNAL_API_KEY=change-me
GEMINI_API_KEY=your-gemini-api-key

# Optional, the default is gemini-4-hydrogen
# GEMINI_MODEL=gemini-4-hydrogen

# Knowledge base (RAG). The defaults work with the local Docker container.
# QDRANT_URL=http://localhost:6333

# RAG_TOP_K=4
# RAG_MIN_SCORE=0.6
