spring.application.name=solarvision-backend

# PostgreSQL Database
spring.datasource.url=jdbc:postgresql://localhost:5432/solarvision_db
spring.datasource.username=postgres
spring.datasource.password=your_password_here

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.open-in-view=false

# Flyway
spring.flyway.enabled=true

# Server
server.port=8080

# JWT
app.jwt.secret=your_jwt_secret_here
app.jwt.expiration-ms=86400000

# Sensor reading simulator (creates fake readings for ACTIVE inverters; keep false in production)
app.simulator.enabled=false
app.simulator.interval-ms=60000
app.simulator.fault-probability=0.0

# Never send Java stack traces to API clients
spring.web.error.include-stacktrace=never

# Origins allowed to call the API from a browser (comma-separated, no spaces)
app.cors.allowed-origins=http://localhost:3000

# --- AI service (Python) ---
app.ai.base-url=http://localhost:8000
# must be the SAME value as INTERNAL_API_KEY in ai-service/.env
app.ai.internal-api-key=<paste the key from ai-service/.env>

# Chat answers can take 5-15 s; this is how long the backend waits (default 45s)
# app.ai.chat-read-timeout=45s

# Demo data: creates demo projects, users and 30 days of readings once at startup.
# Keep false in real use. If true, app.demo.password is required (at least 12 characters).
app.demo.enabled=false
app.demo.password=CHANGE_ME_AT_LEAST_12_CHARACTERS
