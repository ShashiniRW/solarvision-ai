# Copy this file to .env and set a long random value.
# The backend must use the SAME value.
INTERNAL_API_KEY=change-me
GEMINI_API_KEY=your-gemini-api-key

# Optional: models tried in order (the next one answers if one is busy or too slow)
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_THINKING_LEVEL=low   (minimal, low, medium or high)

# Knowledge base (RAG). The defaults work with the local Docker container.
# QDRANT_URL=http://localhost:6333

# RAG_TOP_K=4
# RAG_MIN_SCORE=0.6
